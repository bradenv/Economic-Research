# Copy this file to .env and fill in your own keys (all free)

# FRED - https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# USDA NASS QuickStats - https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# Bureau of Economic Analysis - https://apps.bea.gov/API/signup/
BEA_API_KEY=

# Bureau of Labor Statistics (optional; raises rate limits) - https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Census Bureau - https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
